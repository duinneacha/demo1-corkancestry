<nav id="site-nav" class="site-nav" aria-label="Primary">
  <ul class="nav-list">
    {% for item in nav %}
      <li class="nav-item{% if item.children %} nav-item--has-children{% endif %}">
        <a href="{{ item.href | url }}">{{ item.label }}</a>
        {% if item.children %}
          <ul class="nav-sub">
            {% for child in item.children %}
              <li>
                <a href="{{ child.href | url }}">{{ child.label }}</a>
                {% if child.children %}
                  <ul class="nav-sub nav-sub--nested">
                    {% for grandchild in child.children %}
                      <li><a href="{{ grandchild.href | url }}">{{ grandchild.label }}</a></li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</nav>
